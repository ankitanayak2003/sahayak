# Sahayak Frontend Public Environment Configuration
# NOTE: Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never place database credentials, JWT secrets, or backend API keys in this file.
#
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api/v1
#
# Vercel Production deployment:
# Configure in Vercel Project Settings -> Environment Variables:
# VITE_API_BASE_URL=https://<your-deployed-backend-domain>/api/v1
