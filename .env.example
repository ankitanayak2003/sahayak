# Copy this file to .env and fill in real values.
# Never commit the actual .env file to Git.

# Application
NODE_ENV=development
PORT=5000

# Cloud Deployment & Security (Phase 1)
# Comma-separated allowed frontend origins for CORS. Supports wildcards like *.vercel.app
# Local: http://localhost:3000,http://localhost:5173
# Production: https://sahayak.vercel.app,https://*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://sahayak.vercel.app,https://*.vercel.app

# Set to 1 (or true) when running behind reverse proxies (Render, Railway, AWS ALB, Nginx)
TRUST_PROXY=1

# Maximum request body size limit to prevent DoS
BODY_LIMIT=10mb

# Health readiness requirement: set to true in production if Redis is required for /health/ready
REDIS_REQUIRED=false

# PostgreSQL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://sahayak_user:sahayak_password@localhost:5432/sahayak_db

# Redis
# Format: redis://<host>:<port>
REDIS_URL=redis://localhost:6379

# MongoDB Atlas
MONGODB_URI=mongodb://<user>:<password>@<host>/?ssl=true&replicaSet=<replica_set>&authSource=admin&appName=Sahayak
MONGODB_DB_NAME=sahayak

# Phone security
# Use a random 32-byte key. For convenience, a 64-character hex string is accepted.
PHONE_ENCRYPTION_KEY=replace_with_64_hex_character_encryption_key
# Use a separate random secret string for HMAC blind indexes.
PHONE_BLIND_INDEX_SECRET=replace_with_secure_random_phone_blind_index_secret

# Logging
LOG_LEVEL=info

GEMINI_API_KEY=replace_with_gemini_api_key
SARVAM_API_KEY=replace_with_sarvam_api_key
SARVAM_ORG_ID=replace_with_sarvam_org_id
SARVAM_WORKSPACE_ID=replace_with_sarvam_workspace_id
SARVAM_APP_ID=replace_with_sarvam_app_id
SARVAM_TOOL_SHARED_SECRET=replace_with_sarvam_tool_shared_secret
EXOTEL_WS_USERNAME=replace_with_exotel_ws_username
EXOTEL_WS_PASSWORD=replace_with_exotel_ws_password
EXOTEL_WS_PATH=/ws
# Set to true only for local/demo telephony tests when Exotel Voicebot does not send Basic Auth headers
EXOTEL_ALLOW_UNAUTHENTICATED_WS=false

JWT_SECRET=replace_with_jwt_secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret

# Sahayak Voice Agent Integration
SAHAYAK_BACKEND_URL=http://localhost:5000
SAHAYAK_TOOL_SHARED_SECRET=replace_with_sahayak_tool_shared_secret